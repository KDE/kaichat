[Desktop Entry]
Type=Service
MimeType=text/plain;
Actions=summarizeKAIChat;
X-KDE-Submenu=KAIChat
X-KDE-Submenu[ca]=KAIChat
X-KDE-Submenu[es]=KAIChat
X-KDE-Submenu[he]=KAIChat
X-KDE-Submenu[ka]=KAIChat
X-KDE-Submenu[nl]=KAIChat
X-KDE-Submenu[pt_BR]=KAIChat
X-KDE-Submenu[ru]=KAIChat
X-KDE-Submenu[tr]=KAIChat
X-KDE-Submenu[uk]=KAIChat
X-KDE-MaxNumberOfUrls=1
Icon=kaichat

[Desktop Action summarizeKAIChat]
Name=Summarize Document
Name[ca]=Resumeix un document
Name[es]=Resumir documento
Name[he]=סיכום מסמך
Name[ka]=დოკუმენტის შეჯამება
Name[nl]=Vat document samen
Name[pt_BR]=Resumir documento
Name[ru]=Кратко изложить документ
Name[tr]=Belgeyi Özetle
Name[uk]=Резюме документа
Icon=kaichat
Exec=kaichat --quick-ask --attach %f --prompt summarize
