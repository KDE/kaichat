[Desktop Entry]
Type=Service
MimeType=text/plain;image/png;image/jpeg;image/webp;image/gif;
Actions=askKAIChat;
X-KDE-Submenu=KAIChat
X-KDE-Submenu[ca]=KAIChat
X-KDE-Submenu[es]=KAIChat
X-KDE-Submenu[he]=KAIChat
X-KDE-Submenu[ka]=KAIChat
X-KDE-Submenu[nl]=KAIChat
X-KDE-Submenu[pt_BR]=KAIChat
X-KDE-Submenu[ru]=KAIChat
X-KDE-Submenu[tr]=KAIChat
X-KDE-Submenu[uk]=KAIChat
X-KDE-MaxNumberOfUrls=1
Icon=kaichat

[Desktop Action askKAIChat]
Name=Ask KAIChat…
Name[ca]=Pregunta al KAIChat…
Name[es]=Preguntar a KAIChat…
Name[he]=לשאול את KAIChat…
Name[ka]=კითხვა KAIChat-ისთვის…
Name[nl]=Vraag het aan KAIChat…
Name[pt_BR]=Perguntar ao KAIChat…
Name[ru]=Спросить KAIChat…
Name[tr]=KAIChat’e Sor…
Name[uk]=Запитати KAIChat…
Icon=kaichat
Exec=kaichat --quick-ask --attach %f
