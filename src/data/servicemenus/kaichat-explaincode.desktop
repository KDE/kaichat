[Desktop Entry]
Type=Service
MimeType=text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-python3;text/x-java;text/x-go;text/rust;text/x-cmake;text/x-qml;text/javascript;application/javascript;application/x-shellscript;application/x-perl;application/x-php;text/x-ruby;
Actions=explainCodeKAIChat;
X-KDE-Submenu=KAIChat
X-KDE-MaxNumberOfUrls=1
Icon=kaichat

[Desktop Action explainCodeKAIChat]
Name=Explain Code
Icon=kaichat
Exec=kaichat --quick-ask --attach %f --prompt explain-code
